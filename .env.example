# Copy this file to `.env` and fill in real values. `.env` is git-ignored; never commit it.
# Values containing `$` (such as a bcrypt hash) must be wrapped in single quotes.

# --- API ---
PORT=4000
# Origin of the web app; the only origin allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Folder with the built web app (npm run build -w @acme/web). Set it to serve the web app and the
# API from this one service, as in production. Leave it out in development: the Vite dev server
# serves the web app.
# WEB_DIST_DIR=../web/dist

# --- PostgreSQL ---
# Development database. Replace the placeholders with your own user, password, host and port.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/salary_dev
# Separate database for automated tests, so tests never touch development data.
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/salary_test

# --- Authentication (single HR manager account) ---
HR_USERNAME=hr.manager
# bcrypt hash of the password, not the password itself. Create it with
# `npm run hash-password -w @acme/api` (you type the password at a hidden prompt) and paste
# the whole line it prints, including the single quotes, because the hash contains `$`.
HR_PASSWORD_HASH=
# Random string (at least 32 characters) used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out.
JWT_SECRET=
# How long a login lasts: a number and a unit (s, m, h, d), at most 7d.
JWT_EXPIRES_IN=8h
# How many reverse proxies sit in front of the API (0 = none). Set it to 1 when deployed
# behind a host's proxy, so the login rate limit sees each visitor's real address.
TRUST_PROXY=0

# --- Seed ---
# Fixed seed so the generated 10,000 employees are identical on every run.
SEED_RANDOM=20260101
