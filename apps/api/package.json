{
  "name": "@acme/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express REST API for salary management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json --noEmit && tsx scripts/build.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "migrate:up": "tsx --env-file=../../.env scripts/migrate.ts up",
    "migrate:down": "tsx --env-file=../../.env scripts/migrate.ts down",
    "seed": "tsx --env-file=../../.env scripts/seed.ts",
    "perf": "tsx --env-file=../../.env scripts/perf.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@acme/shared": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "node-pg-migrate": "7.6.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
