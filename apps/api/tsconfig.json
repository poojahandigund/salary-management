{
  // Used by `npm run typecheck` and the editor. Covers source, tests and config files.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node16 emits CommonJS here (no "type": "module" in package.json), so relative
    // imports need no file extensions.
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"]
  },
  "include": ["src", "tests", "scripts", "vitest.config.mts"]
}
